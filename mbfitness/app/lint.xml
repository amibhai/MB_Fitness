<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Versions are pinned on purpose (hard rule 8) and only move when we decide. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />

    <!-- Icons bundled ahead of the screens that use them. Remove this in Phase 8, so anything
         still unused gets flagged and deleted. R8 strips them from a release either way. -->
    <issue id="UnusedResources">
        <ignore path="**/res/drawable/ic_*.xml" />
    </issue>
</lint>
